<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Polyrepo — the parent is a released artifact from GitHub Packages
         (spendwise-shared), not a sibling folder. The empty relativePath stops
         Maven from looking for ../pom.xml first. -->
    <parent>
        <groupId>com.spendwise</groupId>
        <artifactId>spendwise-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <artifactId>api-gateway</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>SpendWise :: API Gateway</name>
    <description>Edge entry point and backend-for-frontend: OIDC login against Keycloak
        (Authorization Code + PKCE) with tokens kept server-side behind an HttpOnly session
        cookie, bearer-token validation for API clients, CORS, security headers, request
        size limits, per-user/IP rate limiting and token relay to the microservices</description>

    <scm>
        <url>https://github.com/PrathameshMax/spendwise-api-gateway</url>
        <connection>scm:git:https://github.com/PrathameshMax/spendwise-api-gateway.git</connection>
    </scm>

    <!-- Where spendwise-parent, spendwise-common and spendwise-events are
         published. Declared here because Maven has to find the parent before it
         can read the repositories the parent declares (Confluent's, for the
         Avro serializer). The id "github" matches the <server> holding the token. -->
    <repositories>
        <repository>
            <id>github</id>
            <name>SpendWise shared libraries</name>
            <url>https://maven.pkg.github.com/PrathameshMax/spendwise-shared</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!-- Milestone 14 — enables Spring Cloud Gateway's built-in RedisRateLimiter
             (Token Bucket Algorithm) and its reactive Lettuce connection factory;
             reactive, not spring-boot-starter-data-redis, because api-gateway is a
             WebFlux/Netty application end-to-end, same reasoning transaction-service's
             Milestone 13 WebClient addition used for choosing the reactive stack. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Backend-for-frontend: the gateway is the OAuth2/OIDC client (Authorization
             Code + PKCE against Keycloak) and keeps tokens server-side; the browser
             only holds an HttpOnly session cookie. Sessions live in Redis so any
             gateway replica can serve any request. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spendwise</groupId>
            <artifactId>spendwise-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
